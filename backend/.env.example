# Port the server listens on (Railway sets this automatically — leave unset in production)
PORT=3001

# Comma-separated list of origins allowed to call this API. In production the
# frontend is served from this same service, so this only matters for local
# dev (the Vite dev server on a different port) — set it to that origin.
FRONTEND_URL=http://localhost:5173

# Set to "production" in Railway so the session cookie is marked Secure
# (HTTPS only). Leave unset for local dev over http://.
NODE_ENV=production

# Shared team password wall (Stage 4). EDIT_PASSWORD is Emilee's password —
# it grants full read/write access. VIEW_PASSWORD is John's password — it
# grants read-only access (all write endpoints reject it with 403). If
# VIEW_PASSWORD is left unset, EDIT_PASSWORD doubles as the view password too,
# so a single password still works.
EDIT_PASSWORD=replace-with-a-long-random-value
VIEW_PASSWORD=replace-with-a-different-long-random-value

# Where the SQLite database file lives. On Railway, mount a Volume and point
# this at a path inside it (e.g. /data/ai-office.db) so data survives
# redeploys — without a volume, the filesystem is wiped on every deploy.
DATABASE_PATH=./data/ai-office.db

# Google Analytics 4 (website traffic — Overview/Performance/Reports, and
# the separate campaign-scoped Wave 1 integration). Optional: the app works
# honestly without these, showing "Not connected" wherever GA4 data would
# appear. See API_INTEGRATION_GUIDE.md for how to generate the service
# account and find each property's ID. Grant the service account Viewer-only
# access in each GA4 property — never a write/edit role.
#
# The full service-account JSON, as a single-line string (from Google Cloud
# Console -> IAM & Admin -> Service Accounts -> Create Key -> JSON).
GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# Each brand's GA4 property ID (GA4 -> Admin -> Property Settings). Only
# entities with their own site/property need a value — leave any of these
# unset for a brand without GA4 and it honestly shows "Not connected" for
# that entity specifically, without breaking the others.
GA4_PROPERTY_ID_MTECH=
GA4_PROPERTY_ID_BRENTWOOD=
GA4_PROPERTY_ID_RADIO_LINKS=
GA4_PROPERTY_ID_CAPCOM=
GA4_PROPERTY_ID_IRCL=
GA4_PROPERTY_ID_IDARO=

# Campaign Monitor (email performance — Overview/Performance/Reports).
# Optional: the app works honestly without this, showing "Not connected"
# wherever email data would appear. See API_INTEGRATION_GUIDE.md.
CAMPAIGN_MONITOR_API_KEY=

# Set to "true" to enable the weekly automatic sync. Leave unset/false to
# only sync on demand (POST /api/campaign-monitor/sync, requires edit access).
CAMPAIGN_MONITOR_SYNC_ENABLED=

# Optional cron schedule override for the weekly sync (default: Sunday 6pm UTC).
CAMPAIGN_MONITOR_SYNC_SCHEDULE=

# Infinity call tracking (Call Tracking page). Optional: the app works
# honestly without these, showing "Not connected" wherever call data would
# appear. Host is fixed at api.infinitycloud.com, auth is "ApiKey <key>" —
# see backend/src/services/infinity.ts for how these were verified against
# the real account.
INFINITY_API_KEY=

# The Infinity Installation Group (IGRP) ID this API key can access — a
# numeric account identifier, found via GET /config/v2.1/igrps. Entity
# attribution within that one IGRP is derived from each call's dgrpName,
# not from a second per-entity ID.
INFINITY_IGRP_ID=

# Google Ads (PPC page, Performance, Reports). Optional: the app works
# honestly without these, showing "Not connected" wherever Google Ads data
# would appear. Unlike GA4's service-account flow, this uses standard
# OAuth2 (a Cloud project's client ID/secret plus a refresh token obtained
# via a one-time consent flow against whichever Google account has access
# to the connected Ads accounts), a developer token issued at the manager
# (MCC) account level, and that manager account as the login-customer-id
# on every request. See backend/src/services/googleAds.ts.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=

# The MTech Group Google Ads manager (MCC) account ID, digits only (dashes
# stripped automatically if present). NOT currently sent on any request —
# confirmed live that Brentwood and Radio Links are queried directly as
# their own customer IDs, and sending login-customer-id on those requests
# fails. Kept here for a future phase (e.g. a genuine manager-account-only
# entity) — see backend/src/services/googleAds.ts's header comment.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Each brand's individual Google Ads customer ID, digits only (dashes
# stripped automatically). Only entities with a currently-connected
# account need a value — leave unset for a brand without Google Ads
# access and it honestly shows "Not connected" for that entity
# specifically, without breaking the others.
GOOGLE_ADS_CUSTOMER_ID_BRENTWOOD=
GOOGLE_ADS_CUSTOMER_ID_RADIO_LINKS=

# Google Search Console (Website page — organic search clicks,
# impressions, CTR, average position, top queries, top landing pages).
# Optional: the app works honestly without these, showing "Not connected"
# wherever Search Console data would appear. Reuses the same
# GA4_SERVICE_ACCOUNT_JSON above (same Google Cloud project, with the
# Search Console API also enabled there) rather than a new credential —
# see backend/src/services/searchConsole.ts. Two things must be true for
# a given property to work: the Search Console API is enabled in that
# project, and the service account's client_email has been added as a
# user (Restricted access is enough) inside Search Console -> Settings ->
# Users and permissions for that specific site.
#
# Each brand's verified Search Console site URL — NOT a property ID like
# GA4. Either "sc-domain:example.com" (Domain property) or
# "https://example.com/" (URL-prefix property), exactly as verified in
# Search Console. Only entities with a real, verified property need a
# value — leave unset for a brand without Search Console access and it
# honestly shows "Not connected" for that entity specifically, without
# breaking the others.
SEARCH_CONSOLE_SITE_URL_BRENTWOOD=
SEARCH_CONSOLE_SITE_URL_RADIO_LINKS=
SEARCH_CONSOLE_SITE_URL_CAPCOM=
SEARCH_CONSOLE_SITE_URL_IDARO=

# Microsoft To Do (My Tasks page), via Microsoft Graph delegated OAuth —
# genuinely different from every integration above: this is a real
# browser-redirect authorization-code flow for one individual's personal
# Microsoft account (Emilee's), not a service account or a static
# pre-issued refresh token. Optional: the app works honestly without
# these, showing "Not connected" wherever Microsoft To Do data would
# appear. See backend/src/services/msGraphAuth.ts and
# backend/src/routes/msGraph.ts.
#
# From the Entra app registration ("MTech Marketing Hub - Microsoft To
# Do"): Application (client) ID, the client secret VALUE (not the secret
# ID), and the Directory (tenant) ID (single-tenant app).
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Must exactly match a Redirect URI registered on the Entra app
# registration (Web platform) — Microsoft validates this exactly, no
# wildcards. Derived from this service's real deployed domain, never
# guessed: <this service's real domain>/api/auth/microsoft/callback.
MS_GRAPH_REDIRECT_URI=
