# Port the server listens on (Railway sets this automatically — leave unset in production)
PORT=3001

# Comma-separated list of origins allowed to call this API. In production the
# frontend is served from this same service, so this only matters for local
# dev (the Vite dev server on a different port) — set it to that origin.
FRONTEND_URL=http://localhost:5173

# Set to "production" in Railway so the session cookie is marked Secure
# (HTTPS only). Leave unset for local dev over http://.
NODE_ENV=production

# Shared team password wall (Stage 4). EDIT_PASSWORD is Emilee's password —
# it grants full read/write access. VIEW_PASSWORD is John's password — it
# grants read-only access (all write endpoints reject it with 403). If
# VIEW_PASSWORD is left unset, EDIT_PASSWORD doubles as the view password too,
# so a single password still works.
EDIT_PASSWORD=replace-with-a-long-random-value
VIEW_PASSWORD=replace-with-a-different-long-random-value

# Where the SQLite database file lives. On Railway, mount a Volume and point
# this at a path inside it (e.g. /data/ai-office.db) so data survives
# redeploys — without a volume, the filesystem is wiped on every deploy.
DATABASE_PATH=./data/ai-office.db
